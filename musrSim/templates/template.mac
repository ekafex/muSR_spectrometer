############################################################
# Mandok2026PRR-inspired Si-pixel vx-muSR prototype macro
# For musrSim / Geant4
#
# Goal:
#   Approximate the Si-pixel vx-muSR spectrometer described in:
#   Mandok et al., Phys. Rev. Research 8, 013092 (2026)
#
# Coordinate convention:
#   z axis = beam direction
#   sample centered at z = 0
#   upstream layers:   z = -30 mm and -10 mm
#   downstream layers: z = +10 mm and +30 mm
#   muon spin perpendicular to beam, along +x
#
# Main paper geometry:
#   - Four Quad modules
#   - Each Quad = 4 MuPix11 Si-pixel chips
#   - Two Quads upstream, two downstream
#   - Reported detector z positions: +/-10 mm and +/-30 mm
#   - Si thickness used in simulation: 100 um
#   - Polyimide foil in simulation: 25 um
#   - Surface muons: about 4.1 MeV kinetic energy
#   - Sample in middle at z = 0
#   - Simulation sample: 20 mm diameter
#   - vx-muSR test sample: 6 mm diameter Al disk
#
# Notes:
#   1. musrSim box dimensions are half-lengths.
#      Therefore 100 um Si thickness => hz = 0.05 mm.
#   2. Polyimide/Kapton is represented using G4_KAPTON.
#   3. The exact cylindrical Pb collimator hole is approximated
#      by four Pb jaws forming a square 3 mm aperture. This is
#      geometrically close for beam definition but not an exact
#      cylindrical bore. For exact Pb cylinder with circular hole,
#      a Boolean subtraction solid would be needed.
#   4. The paper's permanent magnets are not geometrically specified.
#      Therefore they are not used as stopping/scattering geometry.
#      If your musrSim build supports field commands, add a uniform
#      transverse field of about 6.3 mT around the sample.
############################################################


############################################################
# 0. GENERAL INITIALIZATION
############################################################

/control/verbose 0
/run/verbose 0
/tracking/verbose 0


############################################################
# 1. WORLD
############################################################

# Large air world.
# box World hx hy hz material x y z mother rotation sensitive detectorID
/musr/command construct box World 500 500 750 Air 0 0 0 no_logical_volume norot dead -1


############################################################
# 2. COLLIMATOR APPROXIMATION
############################################################

# Paper analysis identifies incoming muons using a Pb cylindrical
# collimator with a 3 mm diameter hole, and accepts hits within
# 4 mm diameter from the beam-collimator center.
#
# Exact cylindrical-hole Pb collimator is not represented here
# because the simple macro geometry has no robust subtraction solid.
# Instead: four Pb jaws make a square 3 mm aperture.
#
# Aperture half-width = 1.5 mm.
# Collimator placed upstream of layer 1.
# Longitudinal half-thickness chosen as 5 mm; not specified in paper.
#
# This approximation matters only if you generate a broad beam.
# If using a pointlike beam, it mainly documents the beamline aperture.

# Top jaw
/musr/command construct box PbColl_Top    25.0 11.75 5.0 G4_Pb 0  13.25 -55 log_World norot dead -1
# Bottom jaw
/musr/command construct box PbColl_Bottom 25.0 11.75 5.0 G4_Pb 0 -13.25 -55 log_World norot dead -1
# Left jaw
/musr/command construct box PbColl_Left   11.75 1.50 5.0 G4_Pb -13.25 0 -55 log_World norot dead -1
# Right jaw
/musr/command construct box PbColl_Right  11.75 1.50 5.0 G4_Pb  13.25 0 -55 log_World norot dead -1


############################################################
# 3. Si-PIXEL DETECTOR QUADS
############################################################

# MuPix11 active matrix approximation:
#   active area approximately 20.48 mm x 20.0 mm
#   chip half-size used here:
#       hx = 10.24 mm
#       hy = 10.00 mm
#   Si thickness:
#       full thickness = 0.100 mm
#       hz = 0.050 mm
#
# Quad module:
#   2 x 2 chips, approximated as four adjacent active Si chips.
#
# Chip centers:
#   x = +/-10.24 mm
#   y = +/-10.00 mm
#
# Layer positions:
#   L1 z = -30 mm
#   L2 z = -10 mm
#   L3 z = +10 mm
#   L4 z = +30 mm
#
# Detector IDs:
#   1101-1104 = layer 1 chips
#   1201-1204 = layer 2 chips
#   1301-1304 = layer 3 chips
#   1401-1404 = layer 4 chips
#
# In later ROOT analysis, group detector IDs by layer.

############################
# Layer 1: z = -30 mm
############################

/musr/command construct box L1_Chip_XmYm 10.24 10.00 0.05 G4_Si -10.24 -10.00 -30 log_World norot musr/ScintSD 1101
/musr/command construct box L1_Chip_XpYm 10.24 10.00 0.05 G4_Si  10.24 -10.00 -30 log_World norot musr/ScintSD 1102
/musr/command construct box L1_Chip_XmYp 10.24 10.00 0.05 G4_Si -10.24  10.00 -30 log_World norot musr/ScintSD 1103
/musr/command construct box L1_Chip_XpYp 10.24 10.00 0.05 G4_Si  10.24  10.00 -30 log_World norot musr/ScintSD 1104

# 25 um polyimide/Kapton support foil, placed just downstream of Si layer.
# full thickness = 0.025 mm, hz = 0.0125 mm.
/musr/command construct box L1_PolyimideFoil 20.48 20.00 0.0125 G4_KAPTON 0 0 -29.9375 log_World norot dead -1


############################
# Layer 2: z = -10 mm
############################

/musr/command construct box L2_Chip_XmYm 10.24 10.00 0.05 G4_Si -10.24 -10.00 -10 log_World norot musr/ScintSD 1201
/musr/command construct box L2_Chip_XpYm 10.24 10.00 0.05 G4_Si  10.24 -10.00 -10 log_World norot musr/ScintSD 1202
/musr/command construct box L2_Chip_XmYp 10.24 10.00 0.05 G4_Si -10.24  10.00 -10 log_World norot musr/ScintSD 1203
/musr/command construct box L2_Chip_XpYp 10.24 10.00 0.05 G4_Si  10.24  10.00 -10 log_World norot musr/ScintSD 1204

/musr/command construct box L2_PolyimideFoil 20.48 20.00 0.0125 G4_KAPTON 0 0 -9.9375 log_World norot dead -1


############################
# Layer 3: z = +10 mm
############################

/musr/command construct box L3_Chip_XmYm 10.24 10.00 0.05 G4_Si -10.24 -10.00 10 log_World norot musr/ScintSD 1301
/musr/command construct box L3_Chip_XpYm 10.24 10.00 0.05 G4_Si  10.24 -10.00 10 log_World norot musr/ScintSD 1302
/musr/command construct box L3_Chip_XmYp 10.24 10.00 0.05 G4_Si -10.24  10.00 10 log_World norot musr/ScintSD 1303
/musr/command construct box L3_Chip_XpYp 10.24 10.00 0.05 G4_Si  10.24  10.00 10 log_World norot musr/ScintSD 1304

/musr/command construct box L3_PolyimideFoil 20.48 20.00 0.0125 G4_KAPTON 0 0 10.0625 log_World norot dead -1


############################
# Layer 4: z = +30 mm
############################

/musr/command construct box L4_Chip_XmYm 10.24 10.00 0.05 G4_Si -10.24 -10.00 30 log_World norot musr/ScintSD 1401
/musr/command construct box L4_Chip_XpYm 10.24 10.00 0.05 G4_Si  10.24 -10.00 30 log_World norot musr/ScintSD 1402
/musr/command construct box L4_Chip_XmYp 10.24 10.00 0.05 G4_Si -10.24  10.00 30 log_World norot musr/ScintSD 1403
/musr/command construct box L4_Chip_XpYp 10.24 10.00 0.05 G4_Si  10.24  10.00 30 log_World norot musr/ScintSD 1404

/musr/command construct box L4_PolyimideFoil 20.48 20.00 0.0125 G4_KAPTON 0 0 30.0625 log_World norot dead -1


############################################################
# 4. SAMPLE / TARGET
############################################################

# The paper discusses two relevant sample cases:
#
# A) Simulation geometry:
#      sample diameter = 20 mm
#      used for evaluating vertex extrapolation uncertainty.
#
# B) First vx-muSR spectrum:
#      6 mm diameter Al disk between permanent magnets,
#      transverse field about 6.3 mT.
#
# Default below: 6 mm Al disk.
# Thickness is not specified in the paper.
# Here full thickness = 1.0 mm, hz = 0.5 mm.
# Tune thickness if stopping distribution does not peak inside Al.
#
# IMPORTANT:
#   The name Target is useful because musrSim stores special
#   muTarget* information for volumes named Target.

# --- Default: vx-muSR Al disk, 6 mm diameter ---
/musr/command construct tubs Target 0 3.0 0.5 0 360 G4_Al 0 0 0 log_World norot dead 10

# --- Alternative: simulation sample, 20 mm diameter ---
# Uncomment this and comment the 6 mm Al disk above if reproducing
# the scattering-resolution simulation of Sec. III.
#/musr/command construct tubs Target 0 10.0 0.5 0 360 G4_Al 0 0 0 log_World norot dead 10


############################################################
# 5. OPTIONAL SAMPLE SUSPENSION APPROXIMATION
############################################################

# The paper says the samples were suspended on a frame using
# aluminized mylar tape. Exact tape geometry is not specified.
# These thin strips are optional and placed away from the beam center.
#
# Mylar full thickness = 20 um -> hz = 0.010 mm.
# Very thin Al coating is neglected here. Uncomment if needed.

/musr/command construct box MylarTape_Left  1.0 12.0 0.010 G4_MYLAR -8.0 0 0 log_World norot dead -1
/musr/command construct box MylarTape_Right 1.0 12.0 0.010 G4_MYLAR  8.0 0 0 log_World norot dead -1


############################################################
# 6. OPTIONAL MAGNET PLACEHOLDERS
############################################################

# The real vx-muSR spectrum used permanent magnets above and below
# the 6 mm Al disk to generate a transverse field around 6.3 mT.
# The magnet dimensions/materials are not specified in the paper.
#
# Therefore, do not rely on the following blocks for field physics.
# They are only visual placeholders and are kept dead.
# Use your musrSim field command, if available, to impose a uniform
# transverse field at the sample.

#/musr/command construct box Magnet_Top    8 2 4 G4_Fe 0  8 0 log_World norot dead -1
#/musr/command construct box Magnet_Bottom 8 2 4 G4_Fe 0 -8 0 log_World norot dead -1

# Example placeholder only; check your musrSim field-command syntax:
# A transverse field of 6.3 mT perpendicular to initial spin.
# If beam is +z and spin is +x, use field along +y for TF precession.
#
# /musr/command globalField 0 0.0063 0 tesla
#
# Do not uncomment unless this command exists in your musrSim build.


############################################################
# 7. PHYSICS CONFIGURATION
############################################################

# Electromagnetic processes relevant for:
#   - multiple Coulomb scattering in thin Si layers
#   - ionization energy deposition in Si
#   - positron transport after muon decay
#
# Transportation is handled internally by Geant4.
# Decay is explicitly included for mu+ so that positrons are generated.

############################
# gamma
############################
/musr/command process addDiscreteProcess gamma G4PhotoElectricEffect
/musr/command process addDiscreteProcess gamma G4ComptonScattering
/musr/command process addDiscreteProcess gamma G4GammaConversion
/musr/command process addDiscreteProcess gamma G4RayleighScattering

############################
# electrons
############################
/musr/command process addProcess e- G4eMultipleScattering -1 1 1
/musr/command process addProcess e- G4eIonisation         -1 2 2
/musr/command process addProcess e- G4eBremsstrahlung     -1 3 3

############################
# positrons
############################
/musr/command process addProcess e+ G4eMultipleScattering -1 1 1
/musr/command process addProcess e+ G4eIonisation         -1 2 2
/musr/command process addProcess e+ G4eBremsstrahlung     -1 3 3
/musr/command process addProcess e+ G4eplusAnnihilation    0 -1 4

############################
# positive muons
############################
/musr/command process addProcess mu+ G4MuMultipleScattering -1 1 1
/musr/command process addProcess mu+ G4MuIonisation         -1 2 2
/musr/command process addProcess mu+ G4MuBremsstrahlung     -1 3 3
/musr/command process addProcess mu+ G4MuPairProduction     -1 4 4
/musr/command process addProcess mu+ G4Decay                0 -1 5

# Step limiter helps in thin detector layers.
# Keep post-step ordering after EM processes.
/musr/command process addProcess mu+ G4StepLimiter -1 -1 6
/musr/command process addProcess e+  G4StepLimiter -1 -1 6
/musr/command process addProcess e-  G4StepLimiter -1 -1 6


############################################################
# 8. USER LIMITS AND CUTS
############################################################

# For 100 um Si and 25 um foil, small steps are useful.
# These are conservative. Relax if the run is too slow.

#/run/setCut 0.01 mm

/musr/command SetUserLimits log_L1_Chip_XmYm 0.01
/musr/command SetUserLimits log_L1_Chip_XpYm 0.01
/musr/command SetUserLimits log_L1_Chip_XmYp 0.01
/musr/command SetUserLimits log_L1_Chip_XpYp 0.01

/musr/command SetUserLimits log_L2_Chip_XmYm 0.01
/musr/command SetUserLimits log_L2_Chip_XpYm 0.01
/musr/command SetUserLimits log_L2_Chip_XmYp 0.01
/musr/command SetUserLimits log_L2_Chip_XpYp 0.01

/musr/command SetUserLimits log_L3_Chip_XmYm 0.01
/musr/command SetUserLimits log_L3_Chip_XpYm 0.01
/musr/command SetUserLimits log_L3_Chip_XmYp 0.01
/musr/command SetUserLimits log_L3_Chip_XpYp 0.01

/musr/command SetUserLimits log_L4_Chip_XmYm 0.01
/musr/command SetUserLimits log_L4_Chip_XpYm 0.01
/musr/command SetUserLimits log_L4_Chip_XmYp 0.01
/musr/command SetUserLimits log_L4_Chip_XpYp 0.01

/musr/command SetUserLimits log_Target 0.01


############################################################
# 9. PRIMARY BEAM
############################################################

# Surface muon beam:
#   kinetic energy about 4.1 MeV
#   incident perpendicular to layer 1
#   beam along +z
#   spin polarization perpendicular to beam
#
# For the paper's Sec. III scattering simulation:
#   pointlike muon beam, 10 million particles.
#
# For a more beamline-like run:
#   use a small Gaussian or uniform transverse beam spot and let
#   the Pb jaws define/clean the aperture.

# Primary particle
/gun/particle mu+

# Start upstream of collimator and layer 1.
/gun/position 0 0 -100 mm

# Beam along +z.
/gun/direction 0 0 1

# Surface muon kinetic energy.
/gun/energy 4.1 MeV

# Initial muon spin perpendicular to beam.
/gun/polarization 1 0 0
/gun/muonPolarizFraction 1.0

# Pointlike beam: closest to paper Sec. III simulation.
# No vertex smearing command needed if position is fixed.

# Optional: finite beam spot.
# Positive values = Gaussian sigma in mm.
# Use sigma about 1 mm to stay mostly inside the 3 mm collimator aperture.
#/gun/vertexsigma 1.0 1.0 0 mm

# Optional: approximate continuous source timing.
# 40 kHz corresponds to mean separation 25 us.
# Use only if your musrSim primary generator supports this command.
#/gun/meanarrivaltime 25 microsecond


############################################################
# 10. OUTPUT SETTINGS
############################################################

# Keep all events for post-processing of:
#   - hit coordinates in each Si layer
#   - Target stopping coordinates
#   - positron tracks
#
# If file size becomes too large, later restrict to events with
# hits in the Si chips.

/musr/command rootOutputDirectoryName data
/musr/command storeOnlyEventsWithHits false

# If using store-only filters, apply to all Si layers.
# Uncomment only after confirming detector IDs in your output.
#/musr/onlyStoreEventsWithHits 1101
#/musr/onlyStoreEventsWithHits 1102
#/musr/onlyStoreEventsWithHits 1103
#/musr/onlyStoreEventsWithHits 1104
#/musr/onlyStoreEventsWithHits 1201
#/musr/onlyStoreEventsWithHits 1202
#/musr/onlyStoreEventsWithHits 1203
#/musr/onlyStoreEventsWithHits 1204
#/musr/onlyStoreEventsWithHits 1301
#/musr/onlyStoreEventsWithHits 1302
#/musr/onlyStoreEventsWithHits 1303
#/musr/onlyStoreEventsWithHits 1304
#/musr/onlyStoreEventsWithHits 1401
#/musr/onlyStoreEventsWithHits 1402
#/musr/onlyStoreEventsWithHits 1403
#/musr/onlyStoreEventsWithHits 1404


############################################################
# 11. VISUALIZATION ATTRIBUTES
############################################################

/musr/command visattributes log_World invisible

/musr/command visattributes log_PbColl_Top gray
/musr/command visattributes log_PbColl_Bottom gray
/musr/command visattributes log_PbColl_Left gray
/musr/command visattributes log_PbColl_Right gray

/musr/command visattributes log_Target red

/musr/command visattributes log_L1_Chip_XmYm yellow
/musr/command visattributes log_L1_Chip_XpYm yellow
/musr/command visattributes log_L1_Chip_XmYp yellow
/musr/command visattributes log_L1_Chip_XpYp yellow

/musr/command visattributes log_L2_Chip_XmYm yellow
/musr/command visattributes log_L2_Chip_XpYm yellow
/musr/command visattributes log_L2_Chip_XmYp yellow
/musr/command visattributes log_L2_Chip_XpYp yellow

/musr/command visattributes log_L3_Chip_XmYm cyan
/musr/command visattributes log_L3_Chip_XpYm cyan
/musr/command visattributes log_L3_Chip_XmYp cyan
/musr/command visattributes log_L3_Chip_XpYp cyan

/musr/command visattributes log_L4_Chip_XmYm cyan
/musr/command visattributes log_L4_Chip_XpYm cyan
/musr/command visattributes log_L4_Chip_XmYp cyan
/musr/command visattributes log_L4_Chip_XpYp cyan

/musr/command visattributes log_L1_PolyimideFoil green
/musr/command visattributes log_L2_PolyimideFoil green
/musr/command visattributes log_L3_PolyimideFoil green
/musr/command visattributes log_L4_PolyimideFoil green

/musr/command visattributes log_MylarTape_Left blue
/musr/command visattributes log_MylarTape_Right blue


############################################################
# 12. INITIALIZE AND RUN
############################################################

/run/initialize

# Disable visualization for production.
/vis/disable

# Print frequency.
# Put this before beamOn so it takes effect during the run.
/musr/run/howOftenToPrintEvent 10000

# Paper simulation used 10 million particles.
# Start with 100k for debugging; increase to 10000000 for production.
/run/beamOn 100000

# Production:
#/run/beamOn 10000000
