\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces  Reconstructed transverse-field vx-$\mu $SR signal for a $\SI {6}{mm}$-diameter aluminium target in a uniform $\SI {6.3}{mT}$ field. The spectra are built from matched muon and positron tracklets inside the time window $0<\Delta t<\SI {13}{\micro s}$. The asymmetry shows the expected oscillatory behaviour, although the present statistics are limited. \relax }}{6}{figure.caption.9}\protected@file@percent }
\newlabel{fig:vxmusr_spectrum}{{4}{6}{Reconstructed transverse-field vx-$\mu $SR signal for a $\SI {6}{mm}$-diameter aluminium target in a uniform $\SI {6.3}{mT}$ field. The spectra are built from matched muon and positron tracklets inside the time window $0<\Delta t<\SI {13}{\micro s}$. The asymmetry shows the expected oscillatory behaviour, although the present statistics are limited. \relax }{figure.caption.9}{}}
