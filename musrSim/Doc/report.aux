\@writefile{toc}{\contentsline {section}{\numberline {2}Simulation 1: Track-Reconstruction Residual versus Inner-Layer Distance}{3}{section.2}\protected@file@percent }
\newlabel{sec:sim1}{{2}{3}{Simulation 1: Track-Reconstruction Residual versus Inner-Layer Distance}{section.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Simulation conditions for the reconstruction-residual study.\relax }}{3}{table.caption.5}\protected@file@percent }
\newlabel{tab:sim1_conditions}{{3}{3}{Simulation conditions for the reconstruction-residual study.\relax }{table.caption.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Simulation-level geometrical acceptance as a function of the inner-layer distance $d$. The $\mu ^+$ track acceptance requires valid hits in both upstream layers L1 and L2. The positron single-layer acceptances require a hit in L3 or L4 and are normalized to the number of muons decaying in the target. The $e^+$ track acceptance requires valid hits in both L3 and L4, with the same target-decay normalization. Since no detector-response inefficiency is included, these curves represent geometrical and analysis-selection acceptance, not experimental detector efficiency. \relax }}{3}{figure.caption.6}\protected@file@percent }
\newlabel{fig:geometrical_accept}{{2}{3}{Simulation-level geometrical acceptance as a function of the inner-layer distance $d$. The $\mu ^+$ track acceptance requires valid hits in both upstream layers L1 and L2. The positron single-layer acceptances require a hit in L3 or L4 and are normalized to the number of muons decaying in the target. The $e^+$ track acceptance requires valid hits in both L3 and L4, with the same target-decay normalization. Since no detector-response inefficiency is included, these curves represent geometrical and analysis-selection acceptance, not experimental detector efficiency. \relax }{figure.caption.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Mean and standard deviation of the reconstruction residuals as functions of the inner-layer distance $d$. The width $\sigma (\delta _\mu )$ is used as the main estimate of the muon vertex-reconstruction uncertainty.  \relax }}{4}{figure.caption.7}\protected@file@percent }
\newlabel{fig:delta_mean_std}{{3}{4}{Mean and standard deviation of the reconstruction residuals as functions of the inner-layer distance $d$. The width $\sigma (\delta _\mu )$ is used as the main estimate of the muon vertex-reconstruction uncertainty.  \relax }{figure.caption.7}{}}
\@writefile{toc}{\contentsline {section}{\numberline {3}Simulation 2: Transverse-Field vx-$\mu $SR Spectrum}{4}{section.3}\protected@file@percent }
\newlabel{sec:sim2}{{3}{4}{Simulation 2: Transverse-Field vx-\texorpdfstring {$\mu $}{mu}SR Spectrum}{section.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Simulation conditions for the transverse-field vx-$\mu $SR study.\relax }}{5}{table.caption.8}\protected@file@percent }
