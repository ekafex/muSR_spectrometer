\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Reconstructed transverse-field vx-$\mu $SR signal for a $\SI {6}{mm}$-diameter aluminium target in a uniform $\SI {6.3}{mT}$ field. The spectra are built from matched muon and positron tracklets inside the time window $0<\Delta t<\SI {13}{\micro s}$. The normalization constants $N_0$ are obtained from the fits and are listed in Table\nobreakspace  {}\ref {tab:sim2_param}. The asymmetry shows the expected oscillatory behaviour, although the present statistics are limited. \relax }}{6}{figure.caption.9}\protected@file@percent }
\newlabel{fig:vxmusr_spectrum}{{4}{6}{Reconstructed transverse-field vx-$\mu $SR signal for a $\SI {6}{mm}$-diameter aluminium target in a uniform $\SI {6.3}{mT}$ field. The spectra are built from matched muon and positron tracklets inside the time window $0<\Delta t<\SI {13}{\micro s}$. The normalization constants $N_0$ are obtained from the fits and are listed in Table~\ref {tab:sim2_param}. The asymmetry shows the expected oscillatory behaviour, although the present statistics are limited. \relax }{figure.caption.9}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Reconstructed transverse-field vx-$\mu $SR spectra fit-parameters shown in Fig.\nobreakspace  {}\ref {fig:vxmusr_spectrum}.\relax }}{6}{table.caption.10}\protected@file@percent }
\newlabel{tab:sim2_param}{{5}{6}{Reconstructed transverse-field vx-$\mu $SR spectra fit-parameters shown in Fig.~\ref {fig:vxmusr_spectrum}.\relax }{table.caption.10}{}}
